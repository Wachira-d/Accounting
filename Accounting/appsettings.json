    "_comment": "REQUIRED: Set JWT_SECRET environment variable in production!",
    "Secret": "",
    "Issuer": "AccountingAPI",
    "Audience": "AccountingClient",
    "ExpireMinutes": "60",
    "RefreshTokenDays": "7"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "RateLimit": {
    "MaxPerMinute": "600"
  },
  "Security": {
    "_comment": "Set ENCRYPTION_KEY env var for encrypting sensitive DB fields",
    "EncryptionKey": "",
    "MaxRequestSizeBytes": "10485760",
    "MaxLoginAttemptsBeforeLockout": "5",
    "LockoutMinutes": "15"
  },
  "Email": {
    "SmtpHost": "",
    "SmtpPort": "587",
    "Username": "",
    "Password": "",
