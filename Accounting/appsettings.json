{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "_comment": "Override via env: ConnectionStrings__DefaultConnection",
    "DefaultConnection": "Host=localhost;Port=5432;Database=AccountingDB;Username=postgres;Password=postgres"
  },
