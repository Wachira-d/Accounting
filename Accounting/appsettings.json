    "_comment": "Set PORTAL_SIGNING_KEY env var in production",
    "SigningKey": ""
  },
  "App": {
    "BaseUrl": "https://app.nextacc.com"
  },
  "Line": {
    "ChannelAccessToken": "",
    "GroupId": ""
