{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=AccountingDB;User Id=sa;Password=YOUR_DB_PASSWORD;TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Secret": "CHANGE_THIS_TO_A_STRONG_SECRET_KEY_AT_LEAST_32_CHARS!!",
    "Issuer": "AccountingAPI",
    "Audience": "AccountingClient",
    "ExpireMinutes": "60",
    "RefreshTokenDays": "7"
  },
  "Cors": {
    "AllowedOrigins": [ "https://yourdomain.com" ]
  },
  "RateLimit": {
    "MaxPerMinute": "120"
  }
}
